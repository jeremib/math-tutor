# Required for the homework helper. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Production: a Postgres connection string. Leave unset in development to use
# PGlite, an embedded Postgres stored under DATA_DIR (nothing to install).
# DATABASE_URL=postgres://user:password@host:5432/mathtutor
# DATABASE_POOL_SIZE=10

# Where uploaded homework photos (and the PGlite database) are stored.
DATA_DIR=./data

# Weekly parent emails (optional). Without these, reports only appear in the parent dashboard.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Math Buddy <reports@yourdomain.com>
# The site's public address, for links in emails.
# APP_URL=https://mathbuddy.example.com
# Protects /api/cron/weekly-reports. Call it weekly with: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=
