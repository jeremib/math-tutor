# Required for the homework helper. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Production: a Postgres connection string. Leave unset in development to use
# PGlite, an embedded Postgres stored under DATA_DIR (nothing to install).
# DATABASE_URL=postgres://user:password@host:5432/mathtutor
# DATABASE_POOL_SIZE=10

# Where uploaded homework photos (and the PGlite database) are stored.
DATA_DIR=./data
